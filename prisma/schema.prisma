// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Hastane/Kurum Modeli - TİTCK Uyumlu
model Hospital {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  address     String?
  city        String?
  country     String   @default("TR")
  phone       String?
  email       String?
  
  // TİTCK ve Regülasyon Bilgileri
  titckNumber String?  // TİTCK Kayıt Numarası
  taxNumber   String?  // Vergi Numarası
  isActive    Boolean  @default(true)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users              User[]
  devices            Device[]
  maintenanceRecords MaintenanceRecord[]
  calibrationRecords CalibrationRecord[]
  workOrders         WorkOrder[]
  procurements       DeviceProcurement[]
  decommissionings   DeviceDecommissioning[]
  contracts          Contract[]
  staff              Staff[]
  trainingSessions   TrainingSession[]
  
  @@map("hospitals")
}

// Kullanıcı Modeli - FDA 21 CFR Part 11 Uyumlu
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  password     String
  role         String   @default("USER") // ADMIN, TECHNICIAN, ENGINEER, USER
  hospitalId   String?
  hospital     Hospital? @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
  phone        String?
  department   String?
  avatarUrl    String?  // Profile picture path
  
  // Güvenlik - FDA 21 CFR Part 11
  twoFactorEnabled    Boolean  @default(false)
  twoFactorSecret     String?
  failedLoginAttempts Int      @default(0)
  lastLoginAt         DateTime?
  lastLoginIp         String?
  
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  maintenanceRecords    MaintenanceRecord[]
  calibrationRecords    CalibrationRecord[]
  deviceMovements       DeviceMovement[]
  workOrders            WorkOrder[]
  auditLogs             AuditLog[]
  signatures            ElectronicSignature[]
  inAppNotifications    InAppNotification[]
  pushSubscriptions     PushSubscription[]
  trainingRecords           TrainingRecord[]
  procurementReceivedBy     DeviceProcurement[]  @relation("ProcurementReceivedBy")
  decommissionRequestedBy   DeviceDecommissioning[]  @relation("DecommissionRequestedBy")
  
  @@index([email])
  @@index([hospitalId])
  @@map("users")
}

// Cihaz Kategorileri
model DeviceCategory {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  group       String?  @default("Genel") // Gruplama için (Görüntüleme, Yaşam Destek vb.)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  devices         Device[]
  deviceTrainings DeviceTraining[]
  
  // Otomatik oluşturulan dokümantasyon
  usageInstructionTemplate String?  // Kullanım talimatı şablonu
  maintenanceProcedureTemplate String?  // Bakım prosedürü şablonu
}

// Lokasyon/Departman
model Location {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  building    String?
  floor       String?
  room        String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  devices         Device[]
  deviceMovements DeviceMovement[]
}

// Tedarikçi
model Supplier {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  contact     String?
  phone       String?
  email       String?
  address     String?
  website     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  devices Device[]
  consumables Consumable[]
  procurements DeviceProcurement[]
  contracts    Contract[]
}

// Sözleşme Modeli
model Contract {
  id              String    @id @default(cuid())
  name            String                          // Sözleşme adı
  contractNumber  String?                         // Sözleşme numarası
  startDate       DateTime                        // Başlangıç tarihi
  endDate         DateTime                        // Bitiş tarihi
  price           Float?                          // Sözleşme fiyatı
  currency        String    @default("TRY")       // Para birimi
  partsIncluded   Boolean   @default(false)       // Parça dahil mi?
  description     String?                         // Açıklama/Notlar
  documentPath    String?                         // Taranmış belge yolu
  status          String    @default("ACTIVE")    // ACTIVE, EXPIRED, CANCELLED
  
  hospitalId      String
  hospital        Hospital  @relation(fields: [hospitalId], references: [id])
  supplierId      String?
  supplier        Supplier? @relation(fields: [supplierId], references: [id])
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@map("contracts")
}

// Ana Cihaz Modeli - EU MDR Uyumlu
model Device {
  id                String         @id @default(cuid())
  name              String
  brand             String?        // Marka
  model             String
  manufacturer      String?
  tagNumber         String         @unique // Künye Numarası (Örn: TAG-2025-001)
  serialNumber      String
  barcode           String?        @unique
  rfidTag           String?        @unique
  categoryId        String
  category          DeviceCategory @relation(fields: [categoryId], references: [id])
  
  // EU MDR - UDI (Unique Device Identification)
  udiDI             String?        // Device Identifier
  udiPI             String?        // Production Identifier
  
  // EU MDR - Risk Sınıflandırması
  riskClass         String?        // I, IIa, IIb, III
  ceMarking         String?        // CE İşareti Numarası
  ceMarkingDate     DateTime?
  
  // FDA Uyumluluğu
  fdaRegistration   String?
  
  @@unique([name, serialNumber])
  
  // Konum ve Sahiplik
  hospitalId        String
  hospital          Hospital       @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  locationId        String?
  location          Location?      @relation(fields: [locationId], references: [id])
  
  // Tedarik Bilgileri
  supplierId        String?
  supplier          Supplier?      @relation(fields: [supplierId], references: [id])
  purchaseDate      DateTime?
  purchasePrice     Float?
  warrantyExpiry    DateTime?
  productionYear    Int?
  
  // Durum ve Bilgiler
  status            String         @default("ACTIVE")
  condition         String         @default("GOOD")
  description       String?
  specifications    String?
  images            String?
  documents         String?
  
  // Bakım ve Kalibrasyon
  lastMaintenanceDate    DateTime?
  nextMaintenanceDate    DateTime?
  maintenanceInterval    Int?
  lastCalibrationDate    DateTime?
  nextCalibrationDate    DateTime?
  calibrationInterval    Int?
  
  // Post-Market Surveillance (MDR)
  adverseEventsCount     Int        @default(0)
  pmsNotes               String?
  
  // Maliyet Takibi
  totalMaintenanceCost   Float?
  totalRepairCost        Float?
  
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  // İlişkiler
  maintenanceRecords    MaintenanceRecord[]
  calibrationRecords    CalibrationRecord[]
  movements             DeviceMovement[]
  consumables           DeviceConsumable[]
  workOrders            WorkOrder[]
  adverseEvents         AdverseEvent[]
  deviceTrainings       DeviceTraining[]
  procurements          DeviceProcurement[]
  decommissionings      DeviceDecommissioning[]
  uptimeRecords         DeviceUptime[]
  
  @@index([hospitalId])
  @@index([status])
  @@index([udiDI])
  @@index([locationId])
  @@index([categoryId])
  @@index([nextMaintenanceDate])
  @@index([nextCalibrationDate])
  @@index([status, hospitalId])
  @@index([hospitalId, status])
  @@map("devices")
}

// Bakım Kayıtları
model MaintenanceRecord {
  id                String            @id @default(cuid())
  deviceId          String
  device            Device            @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  hospitalId        String
  hospital          Hospital          @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  
  type              String            // MaintenanceType enum yerine String
  status            String            @default("SCHEDULED") // SCHEDULED, IN_PROGRESS, COMPLETED, CANCELLED, ON_HOLD
  priority          String            @default("MEDIUM")    // Priority enum yerine String
  
  // Uptime/Downtime Takibi
  isActiveRepair    Boolean           @default(false) // Aktif onarım (downtime)
  repairStartDate   DateTime?         // Onarım başlangıç
  repairEndDate     DateTime?         // Onarım bitiş
  
  scheduledDate     DateTime
  completedDate     DateTime?
  duration          Int?              // Dakika cinsinden
  
  technicianId      String?
  technician        User?             @relation(fields: [technicianId], references: [id])
  
  description       String
  findings          String?
  actions           String?
  notes             String?
  
  // Bakım Prosedürü
  procedure         String?           // Otomatik oluşturulan prosedür
  procedureFile     String?           // PDF dosyası
  
  cost              Float?            // Decimal yerine Float
  partsReplaced     String?           // String[] yerine String
  
  attachments       String?           // String[] yerine String
  
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  
  @@index([deviceId])
  @@index([hospitalId])
  @@index([status])
  @@index([scheduledDate])
  @@index([isActiveRepair])
  @@index([hospitalId, status])
}

// Kalibrasyon Kayıtları
model CalibrationRecord {
  id                String              @id @default(cuid())
  deviceId          String
  device            Device              @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  hospitalId        String
  hospital          Hospital            @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  
  status            String              @default("SCHEDULED") // CalibrationStatus enum yerine String
  
  scheduledDate     DateTime
  completedDate     DateTime?
  expiryDate        DateTime?
  
  technicianId      String?
  technician        User?               @relation(fields: [technicianId], references: [id])
  
  calibrationLab    String?
  certificateNumber String?
  certificateFile   String?             // PDF dosya yolu
  
  result            String?             // CalibrationResult enum yerine String
  findings          String?
  notes             String?
  
  cost              Float?              // Decimal yerine Float
  
  attachments       String?             // String[] yerine String
  
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  
  @@index([deviceId])
  @@index([hospitalId])
  @@index([status])
  @@index([scheduledDate])
  @@index([expiryDate])
}

// Cihaz Hareketleri (Konum Geçmişi)
model DeviceMovement {
  id              String    @id @default(cuid())
  deviceId        String
  device          Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  
  fromLocationId  String?
  fromLocation    Location? @relation(fields: [fromLocationId], references: [id])
  toLocation      String    // Yeni lokasyon (text olarak)
  
  movedBy         String?
  movedByUser     User?     @relation(fields: [movedBy], references: [id])
  
  reason          String?
  notes           String?
  
  movedAt         DateTime  @default(now())
  createdAt       DateTime  @default(now())
}

// Sarf Malzemeleri
model Consumable {
  id              String   @id @default(cuid())
  name            String
  code            String   @unique
  description     String?
  unit            String   // Adet, Kutu, Paket vb.
  minimumStock    Int?
  currentStock    Int      @default(0)
  unitPrice       Float?   // Decimal yerine Float
  
  supplierId      String?
  supplier        Supplier? @relation(fields: [supplierId], references: [id])
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  deviceConsumables DeviceConsumable[]
}

// Cihaz-Sarf Malzeme İlişkisi
model DeviceConsumable {
  id            String     @id @default(cuid())
  deviceId      String
  device        Device     @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  consumableId  String
  consumable    Consumable @relation(fields: [consumableId], references: [id], onDelete: Cascade)
  
  quantityUsed  Int        @default(0)
  lastUsedDate  DateTime?
  notes         String?
  
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

// ============================================
// FDA 21 CFR Part 11 - AUDIT LOG
// ============================================

model AuditLog {
  id          String   @id @default(cuid())
  
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName    String   // Kullanıcı adı (user silinse bile kalır)
  
  action      String   // CREATE, UPDATE, DELETE, LOGIN, LOGOUT, etc.
  entity      String   // Device, Hospital, WorkOrder, etc.
  entityId    String?
  
  // Değişiklik takibi
  beforeValue String?  // JSON formatında önceki değer
  afterValue  String?  // JSON formatında yeni değer
  
  // Meta bilgiler
  ipAddress   String?
  userAgent   String?
  timestamp   DateTime @default(now())
  
  // Tamper protection (hash)
  hash        String?
  
  @@index([userId])
  @@index([entity])
  @@index([timestamp])
  @@index([action])
  @@map("audit_logs")
}

// ============================================
// FDA 21 CFR Part 11 - ELEKTRONİK İMZA
// ============================================

model ElectronicSignature {
  id          String   @id @default(cuid())
  
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  entityType  String   // WorkOrder, Calibration, etc.
  entityId    String
  
  // İmza detayları
  meaning     String   // "Onayladım", "İnceledim", "Tamamladım"
  signedAt    DateTime @default(now())
  ipAddress   String?
  reasonCode  String?  // İmza sebebi kodu
  
  // İlişkiler (opsiyonel)
  workOrderId   String?
  workOrder     WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  calibrationId String?
  
  @@index([userId])
  @@index([workOrderId])
  @@map("electronic_signatures")
}

// ============================================
// İŞ EMRİ (WORK ORDER) YÖNETİMİ
// ============================================

model WorkOrder {
  id              String   @id @default(cuid())
  workOrderNumber String   @unique // WO-2025-0001
  
  // Cihaz
  deviceId        String
  device          Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  
  // Hastane
  hospitalId      String
  hospital        Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  
  // İş emri detayları
  title           String
  description     String
  type            String   // PREVENTIVE, CORRECTIVE, EMERGENCY, INSTALLATION
  priority        String   @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  status          String   @default("OPEN") // OPEN, IN_PROGRESS, ON_HOLD, COMPLETED, CANCELLED
  
  // Atama
  assignedToId    String?
  assignedTo      User?    @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  
  // Zamanlama
  scheduledDate   DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  dueDate         DateTime?
  
  // Çalışma detayları
  findings        String?  // Bulgular
  actionsToken    String?  // Yapılan işlemler
  partsReplaced   String?  // Değiştirilen parçalar
  laborHours      Float?   // İşçilik saati
  cost            Float?   // Toplam maliyet
  
  // Fotoğraflar
  beforePhotoUrls String?
  afterPhotoUrls  String?

  // Bildiren Kişi Bilgileri
  reporterName    String?
  reporterPhone   String?
  reporterTitle   String?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // İlişkiler
  signatures      ElectronicSignature[]
  
  @@index([deviceId])
  @@index([hospitalId])
  @@index([assignedToId])
  @@index([status])
  @@index([scheduledDate])
  @@index([dueDate])
  @@index([hospitalId, status])
  @@index([status, scheduledDate])
  @@map("work_orders")
}

// ============================================
// CAPA - DÜZELTİCİ/ÖNLEYİCİ FAALİYET
// ============================================

model CAPA {
  id               String   @id @default(cuid())
  capaNumber       String   @unique // CAPA-2025-0001
  
  title            String
  description      String
  type             String   // CORRECTIVE, PREVENTIVE
  source           String?  // Audit, Complaint, AdverseEvent, etc.
  
  // Araştırma
  rootCause        String?  // Kök neden analizi
  correctiveAction String?  // Düzeltici faaliyet
  preventiveAction String?  // Önleyici faaliyet
  
  // Atama
  assignedTo       String?
  dueDate          DateTime?
  
  // Durum
  status           String   @default("OPEN") // OPEN, IN_PROGRESS, COMPLETED, CLOSED
  effectiveness    String?  // Etkinlik değerlendirmesi
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  completedAt      DateTime?
  
  @@index([status])
  @@index([dueDate])
  @@map("capas")
}

// ============================================
// MDR VİJİLANS - OLUMSUZ OLAY RAPORLAMA
// ============================================

model AdverseEvent {
  id            String   @id @default(cuid())
  reportNumber  String   @unique // AE-2025-0001
  
  // Cihaz
  deviceId      String
  device        Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  
  // Olay detayları
  eventDate     DateTime
  description   String
  severity      String   // LOW, MEDIUM, HIGH, CRITICAL
  status        String   @default("OPEN") // OPEN, INVESTIGATING, RESOLVED, CLOSED
  
  // Araştırma
  investigationFindings String?
  correctiveActions     String?
  preventiveActions     String?
  
  // Resmi raporlama
  reportedToAuthority   Boolean  @default(false)
  authorityReportNumber String?  // TİTCK/EMA rapor numarası
  reportedDate          DateTime?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  closedAt      DateTime?
  
  @@index([deviceId])
  @@index([eventDate])
  @@index([status])
  @@map("adverse_events")
}

// ============================================
// KVKK - VERİ SAHİBİ TALEPLERİ
// ============================================

model DataSubjectRequest {
  id            String   @id @default(cuid())
  requestNumber String   @unique // DSR-2025-0001
  
  // Talep sahibi
  subjectName   String
  subjectEmail  String
  subjectPhone  String?
  
  // Talep detayları
  requestType   String   // ACCESS, RECTIFICATION, ERASURE, RESTRICTION, PORTABILITY
  description   String
  
  // İşlem
  status        String   @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, REJECTED
  processedBy   String?
  processedAt   DateTime?
  response      String?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  dueDate       DateTime // KVKK: 30 gün içinde yanıt
  
  @@index([status])
  @@index([dueDate])
  @@map("data_subject_requests")
}

// ============================================
// AYARLAR - MODÜL YÖNETİMİ
// ============================================

model AppSettings {
  id                 String   @id @default("default")
  
  // Modül Ayarları (true=aktif, false=pasif)
  maintenanceEnabled     Boolean  @default(false)
  calibrationEnabled     Boolean  @default(false)
  contractsEnabled       Boolean  @default(false)
  utsEnabled             Boolean  @default(false)
  complianceEnabled      Boolean  @default(false)
  reportsEnabled         Boolean  @default(false)
  branchesEnabled        Boolean  @default(false)
  trainingEnabled        Boolean  @default(false)
  procurementEnabled     Boolean  @default(false)
  decommissioningEnabled Boolean  @default(false)

  // Yedekleme Ayarları
  backupAuto             Boolean  @default(false)
  backupSchedule         String   @default("daily") // daily, weekly, monthly
  backupRetention        Int      @default(30)      // Gün olarak saklama süresi

  // Künye Ayarları
  deviceTagFormat        String   @default("TAG-{YYYY}-{SEQ}") // Örn: KUNYE-{YYYY}-{SEQ}

  updatedAt          DateTime @updatedAt
  
  @@map("app_settings")
}

// ============================================
// LİSANS VE DEMO YÖNETİMİ
// ============================================

model SystemLicense {
  id                 String   @id @default("license") // Tek kayıt olacak
  
  // Lisans Durumu
  isDemo             Boolean  @default(true)
  isActive           Boolean  @default(true)
  
  // Zamanlama
  firstRunDate       DateTime @default(now())   // İlk çalıştırma (Demo başlangıcı)
  demoDurationHours  Int      @default(240)     // Varsayılan: 240 saat (10 gün)
  
  // Aktivasyon
  licenseKey         String?  // Girilen lisans anahtarı
  activationDate     DateTime?
  expiryDate         DateTime? // Tam sürüm için varsa bitiş tarihi
  
  // Sistem Bilgisi (Cihaza özel kilit için)
  hardwareId         String?  // Opsiyonel: CPU/HDD seri no hash'i
  
  updatedAt          DateTime @updatedAt
  
  @@map("system_licenses")
}

// ============================================
// NOTIFICATIONS
// ============================================

model InAppNotification {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  title       String
  message     String
  priority    String   @default("medium") // low, medium, high, urgent
  category    String?  // maintenance, calibration, device, etc.
  actionUrl   String?
  metadata    String?  // JSON string
  
  read        Boolean  @default(false)
  readAt      DateTime?
  
  createdAt   DateTime @default(now())
  
  @@index([userId])
  @@index([read])
  @@index([createdAt])
  @@index([userId, read])
  @@map("in_app_notifications")
}

model PushSubscription {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  endpoint    String   @unique
  p256dh      String
  auth        String
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([userId])
  @@map("push_subscriptions")
}

// ============================================
// EŞLEŞMEYEN KALİBRASYON KAYITLARI
// ============================================

model UnmatchedCalibration {
  id                 String   @id @default(cuid())
  
  // Excel'den gelen ham veriler
  deviceSerialNumber String?
  tagNumber          String?
  deviceName         String?
  brand              String?
  model              String?
  location           String?  // Bölüm/Departman için
  hospitalId         String?  // Hastane/Şube filtreleme için
  
  calibrationLab     String?
  scheduledDate      DateTime?
  completedDate      DateTime?
  expiryDate         DateTime?
  technicianName     String?
  
  status             String?
  result             String?
  certificateNumber  String?
  cost               Float?
  
  createdAt          DateTime @default(now())
  
  @@index([hospitalId])
  @@map("unmatched_calibrations")
}

// ============================================
// EĞİTİM MODÜLÜ
// ============================================

model TrainingRecord {
  id                String   @id @default(cuid())
  trainingNumber    String   @unique // TRN-2025-001
  
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Eğitim Bilgileri
  trainingType      String   // DEVICE_SPECIFIC, GENERAL_SAFETY, MAINTENANCE, CALIBRATION
  title             String
  description       String?
  trainingDate      DateTime
  duration          Int      // Dakika cinsinden
  instructor        String?
  institution       String?
  
  // İçerik
  content           String?  // HTML/Markdown içerik
  contentFile       String?  // PDF/DOCX dosyası
  
  // Sertifikasyon
  certificateNumber String?
  certificateFile   String?  // PDF
  expiryDate        DateTime?
  
  // Sonuç
  status            String   @default("PLANNED") // PLANNED, COMPLETED, FAILED, EXPIRED
  score             Float?
  passingScore      Float?
  notes             String?
  
  // İlişkiler
  deviceTrainings   DeviceTraining[]
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@index([userId])
  @@index([trainingType])
  @@index([status])
  @@index([trainingDate])
}

model DeviceTraining {
  id                String         @id @default(cuid())
  trainingRecordId  String
  trainingRecord    TrainingRecord @relation(fields: [trainingRecordId], references: [id], onDelete: Cascade)
  deviceId          String?
  device            Device?        @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  deviceCategoryId  String?
  deviceCategory    DeviceCategory? @relation(fields: [deviceCategoryId], references: [id])
  
  // Yetkilendirme
  authorized        Boolean  @default(false)
  authorizedBy      String?
  authorizedDate    DateTime?
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@index([trainingRecordId])
  @@index([deviceId])
  @@index([deviceCategoryId])
}

// ============================================
// CİHAZ TESLİM ALMA VE HİZMETE SUNMA
// ============================================

model DeviceProcurement {
  id                    String   @id @default(cuid())
  purchaseOrderNumber   String   @unique
  
  deviceId              String?
  device                Device?  @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  hospitalId            String
  hospital              Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  
  // Sipariş Bilgileri
  supplierId            String?
  supplier              Supplier? @relation(fields: [supplierId], references: [id])
  orderDate             DateTime
  expectedDeliveryDate  DateTime?
  actualDeliveryDate    DateTime?
  
  // Teslim Alma
  deliveryStatus        String   @default("PENDING") // PENDING, DELIVERED, REJECTED, RETURNED
  deliveryChecklist     String?  // JSON: {ambalaj: bool, belgeler: bool, ...}
  deliveryNotes         String?
  receivedBy            String?
  receivedByUser        User?    @relation("ProcurementReceivedBy", fields: [receivedBy], references: [id], onDelete: SetNull)
  receivedDate          DateTime?
  
  // Kurulum ve Test
  installationStatus    String?  // PENDING, IN_PROGRESS, COMPLETED
  installationDate      DateTime?
  installerName         String?
  installationNotes     String?
  testResults           String?  // JSON: {test1: pass/fail, ...}
  
  // Onay
  acceptanceStatus      String?  // PENDING, ACCEPTED, REJECTED
  acceptedBy            String?
  acceptanceDate        DateTime?
  rejectionReason       String?
  
  // Hizmete Alma
  commissioningStatus   String   @default("PENDING") // PENDING, COMMISSIONED
  commissionedBy        String?
  commissionedDate      DateTime?
  firstUserTrainingDate DateTime?
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  @@index([deviceId])
  @@index([hospitalId])
  @@index([supplierId])
  @@index([deliveryStatus])
  @@index([acceptanceStatus])
}


// ============================================
// CİHAZ KULLANIM DIŞI BIRAKMA
// ============================================

model DeviceDecommissioning {
  id                  String   @id @default(cuid())
  decommissionNumber  String   @unique // DEC-2025-001
  
  deviceId            String
  device              Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  hospitalId          String
  hospital            Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  
  // Talep
  requestDate         DateTime @default(now())
  requestedBy         String?
  requestedByUser     User?    @relation("DecommissionRequestedBy", fields: [requestedBy], references: [id], onDelete: SetNull)
  reason              String   // OBSOLETE, DAMAGED, REPLACED, SAFETY_CONCERN
  reasonDetails       String?
  
  // Değerlendirme
  evaluationStatus    String   @default("PENDING") // PENDING, EVALUATING, APPROVED, REJECTED
  evaluatedBy         String?
  evaluationDate      DateTime?
  evaluationNotes     String?
  technicalAssessment String?  // JSON
  
  // Onay
  approvalStatus      String?  // PENDING, APPROVED, REJECTED
  approvedBy          String?
  approvalDate        DateTime?
  rejectionReason     String?
  
  // Fiziksel İşlem
  disposalMethod      String?  // SCRAP, DONATION, SALE, RECYCLE, STORAGE
  disposalDate        DateTime?
  disposalLocation    String?
  disposalCertificate String?  // PDF dosyası
  dataWiped           Boolean  @default(false)
  dataWipeDate        DateTime?
  dataWipeMethod      String?
  
  // Final
  status              String   @default("REQUESTED") // REQUESTED, APPROVED, COMPLETED
  completedDate       DateTime?
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  
  @@index([deviceId])
  @@index([hospitalId])
  @@index([status])
  @@index([requestDate])
}

// ============================================
// UPTIME/DOWNTIME TAKİBİ
// ============================================

model DeviceUptime {
  id                String   @id @default(cuid())
  deviceId          String
  device            Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  
  // Zaman Aralığı
  startDate         DateTime
  endDate           DateTime?
  
  // Durum
  status            String   // ACTIVE, DOWNTIME, MAINTENANCE
  reason            String?  // Downtime nedeni
  
  // Hesaplanan Süreler (saniye cinsinden)
  totalSeconds      Int?     // Toplam süre
  
  // İlişkili Kayıtlar
  maintenanceRecordId String?
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@index([deviceId])
  @@index([startDate])
  @@index([status])
}

// DeviceCategory ilişkisi için güncelleme

// ============================================
// PERSONEL VE EĞİTİM YÖNETİMİ
// ============================================

// Sağlık Personeli
model Staff {
  id                 String   @id @default(cuid())
  registrationNumber String   @unique // Sicil Numarası
  idNumber           String?  // TC Kimlik Numarası
  name               String
  department         String?  // Departman/Birim
  title              String?  // Unvan (Hemşire, Teknisyen, vb.)
  phone              String?
  email              String?
  
  hospitalId         String?
  hospital           Hospital? @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
  
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  
  trainings          StaffTraining[]
  
  @@index([hospitalId])
  @@index([registrationNumber])
  @@index([department])
  @@index([idNumber])
  @@map("staff")
}

// Eğitim Oturumu
model TrainingSession {
  id              String   @id @default(cuid())
  sessionNumber   String   @unique // TRN-2024-001
  title           String   // Eğitim Konusu
  trainer         String?  // Eğitimi Veren Kişi
  trainerOrg      String?  // Eğitimi Veren Firma/Kurum
  durationMinutes Int      @default(60) // Süre (dakika)
  content         String?  // Eğitim İçeriği
  trainingDate    DateTime // Eğitim Tarihi
  
  // İlişkili Cihaz/Kategori (opsiyonel)
  deviceCategoryId String?
  
  hospitalId      String?
  hospital        Hospital? @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
  
  // Geçerlilik Süresi (ay olarak, null = süresiz)
  validityMonths  Int?     @default(12)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  attendees       StaffTraining[]
  documents       TrainingDocument[]
  
  @@index([hospitalId])
  @@index([trainingDate])
  @@index([sessionNumber])
  @@map("training_sessions")
}

// Eğitim Dokümantasyonu
model TrainingDocument {
  id          String   @id @default(cuid())
  sessionId   String
  session     TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  
  filename    String   // Orijinal dosya adı
  filepath    String   // Sunucudaki dosya yolu
  filesize    Int      // Dosya boyutu (bytes)
  mimetype    String   // Dosya türü
  
  uploadedAt  DateTime @default(now())
  
  @@index([sessionId])
  @@map("training_documents")
}

// Personel-Eğitim İlişkisi
model StaffTraining {
  id          String   @id @default(cuid())
  
  staffId     String
  staff       Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  
  sessionId   String
  session     TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  
  status      String   @default("COMPLETED") // COMPLETED, ABSENT, PENDING
  completedAt DateTime @default(now())
  
  // Sertifika bilgisi
  certificateNumber String?
  expiryDate        DateTime? // Eğitim geçerlilik bitiş tarihi
  
  createdAt   DateTime @default(now())
  
  @@unique([staffId, sessionId])
  @@index([staffId])
  @@index([sessionId])
  @@index([status])
  @@map("staff_trainings")
}