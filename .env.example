# ==========================================
# MediSync Tıbbi Cihaz Yönetim Portalı
# Çevre Değişkenleri Şablonu (.env.example)
# ==========================================

# PostgreSQL Veritabanı Bağlantı Dizesi
DATABASE_URL="postgresql://postgres:postgres_sifreniz@localhost:5432/medisync?schema=public"

# NextAuth Güvenlik Anahtarı (openssl rand -base64 32 ile üretebilirsiniz)
NEXTAUTH_SECRET="guclu-ve-rastgele-bir-gizli-anahtar-yaziniz"

# Uygulama Web Adresi (Domain veya Yerel IP)
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Opsiyonel: E-Posta SMTP Bildirimleri (Gerekirse)
# SMTP_HOST="smtp.ornekhastane.com"
# SMTP_PORT=587
# SMTP_USER="bildirim@ornekhastane.com"
# SMTP_PASS="smtp_sifreniz"
