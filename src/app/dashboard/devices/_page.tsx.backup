'use client'

import { useState } from 'react'
import { 
  Search, 
  Filter, 
  Plus, 
  Download,
  Package,
  MapPin,
  Calendar,
  QrCode
} from 'lucide-react'
import { exportDevicesToExcel } from '@/lib/export'
import BarcodeReader from '@/components/BarcodeReader'
import { useToast } from '@/components/ToastProvider'

// Demo data
const demoDevices = [
  {
    id: '1',
    name: 'MRI Cihazı',
    model: 'Siemens Magnetom Skyra 3T',
    serialNumber: 'SN-12345-MRI',
    category: 'Görüntüleme',
    location: 'Radyoloji',
    status: 'ACTIVE',
    lastMaintenance: '2024-10-15',
  },
  {
    id: '2',
    name: 'Ultrason Cihazı',
    model: 'GE Voluson E10',
    serialNumber: 'SN-67890-USG',
    category: 'Görüntüleme',
    location: 'Kadın Hastalıkları',
    status: 'ACTIVE',
    lastMaintenance: '2024-11-01',
  },
  {
    id: '3',
    name: 'Defibrilatör',
    model: 'Zoll X Series',
    serialNumber: 'SN-11223-DEF',
    category: 'Acil',
    location: 'Acil Servis',
    status: 'MAINTENANCE',
    lastMaintenance: '2024-11-18',
  },
  {
    id: '4',
    name: 'EKG Cihazı',
    model: 'Philips PageWriter TC70',
    serialNumber: 'SN-44556-ECG',
    category: 'Kardiyoloji',
    location: 'Kardiyoloji Polikliniği',
    status: 'ACTIVE',
    lastMaintenance: '2024-09-10',
  },
  {
    id: '5',
    name: 'Hasta Monitörü',
    model: 'GE Dash 4000',
    serialNumber: 'SN-78901-MON',
    category: 'Monitör',
    location: 'Yoğun Bakım',
    status: 'CALIBRATION',
    lastMaintenance: '2024-10-20',
  },
]

export default function DevicesPage() {
  const [searchTerm, setSearchTerm] = useState('')
  const [filterStatus, setFilterStatus] = useState('ALL')
  const [showBarcodeReader, setShowBarcodeReader] = useState(false)
  const { showSuccess, showError } = useToast()

  const filteredDevices = demoDevices.filter(device => {
    const matchesSearch = device.name.toLowerCase().includes(searchTerm.toLowerCase()) ||
                         device.model.toLowerCase().includes(searchTerm.toLowerCase()) ||
                         device.serialNumber.toLowerCase().includes(searchTerm.toLowerCase())
    const matchesFilter = filterStatus === 'ALL' || device.status === filterStatus
    return matchesSearch && matchesFilter
  })

  const handleBarcodeScann = (code: string) => {
    const device = demoDevices.find(d => d.serialNumber === code)
    
    if (device) {
      showSuccess(`Cihaz bulundu: ${device.name}`)
      setSearchTerm(code)
    } else {
      showError('Cihaz bulunamadı')
    }
    setShowBarcodeReader(false)
  }

  const handleExportExcel = () => {
    exportDevicesToExcel(filteredDevices)
    showSuccess('Excel dosyası indirildi')
  }

  return (
    <div className="space-y-6">
      {/* Header */}
      <div className="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
          <h1 className="text-3xl font-bold text-gray-900">Cihaz Yönetimi</h1>
          <p className="text-gray-600 mt-1">Tüm tıbbi cihazları görüntüleyin ve yönetin</p>
        </div>
        <div className="flex items-center space-x-3">
          <button 
            onClick={() => setShowBarcodeReader(true)}
            className="bg-gray-100 hover:bg-gray-200 text-gray-700 px-4 py-3 rounded-lg font-semibold flex items-center space-x-2 transition-colors"
          >
            <QrCode className="h-5 w-5" />
            <span>Barkod Oku</span>
          </button>
          <button className="bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-lg font-semibold flex items-center space-x-2 transition-colors">
            <Plus className="h-5 w-5" />
            <span>Yeni Cihaz Ekle</span>
          </button>
        </div>
      </div>

      {/* Stats */}
      <div className="grid grid-cols-1 md:grid-cols-4 gap-4">
        <QuickStat label="Toplam Cihaz" value={demoDevices.length} icon={<Package />} color="blue" />
        <QuickStat
          label="Aktif"
          value={demoDevices.filter(d => d.status === 'ACTIVE').length}
          icon={<Package />}
          color="green"
        />
        <QuickStat
          label="Bakımda"
          value={demoDevices.filter(d => d.status === 'MAINTENANCE').length}
          icon={<Package />}
          color="orange"
        />
        <QuickStat
          label="Kalibrasyonda"
          value={demoDevices.filter(d => d.status === 'CALIBRATION').length}
          icon={<Package />}
          color="purple"
        />
      </div>

      {/* Search and Filters */}
      <div className="bg-white rounded-xl shadow-lg p-6">
        <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div className="relative md:col-span-2">
            <Search className="absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-400 h-5 w-5" />
            <input
              type="text"
              placeholder="Cihaz adı, model veya seri numarası ile ara..."
              value={searchTerm}
              onChange={(e) => setSearchTerm(e.target.value)}
              className="w-full pl-10 pr-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
            />
          </div>

          <div className="relative">
            <Filter className="absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-400 h-5 w-5" />
            <select
              value={filterStatus}
              onChange={(e) => setFilterStatus(e.target.value)}
              className="w-full pl-10 pr-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent appearance-none"
            >
              <option value="ALL">Tüm Durumlar</option>
              <option value="ACTIVE">Aktif</option>
              <option value="MAINTENANCE">Bakımda</option>
              <option value="CALIBRATION">Kalibrasyonda</option>
              <option value="INACTIVE">Pasif</option>
            </select>
          </div>
        </div>

        <div className="mt-4 flex justify-end">
          <button 
            onClick={handleExportExcel}
            className="flex items-center space-x-2 px-4 py-2 border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors"
          >
            <Download className="h-4 w-4" />
            <span className="text-sm font-medium">Excel'e Aktar</span>
          </button>
        </div>
      </div>

      {/* Devices Table */}
      <div className="bg-white rounded-xl shadow-lg overflow-hidden">
        <div className="overflow-x-auto">
          <table className="w-full">
            <thead className="bg-gray-50 border-b border-gray-200">
              <tr>
                <th className="px-6 py-4 text-left text-xs font-semibold text-gray-700 uppercase tracking-wider">Cihaz</th>
                <th className="px-6 py-4 text-left text-xs font-semibold text-gray-700 uppercase tracking-wider">Seri No</th>
                <th className="px-6 py-4 text-left text-xs font-semibold text-gray-700 uppercase tracking-wider">Kategori</th>
                <th className="px-6 py-4 text-left text-xs font-semibold text-gray-700 uppercase tracking-wider">Lokasyon</th>
                <th className="px-6 py-4 text-left text-xs font-semibold text-gray-700 uppercase tracking-wider">Durum</th>
                <th className="px-6 py-4 text-left text-xs font-semibold text-gray-700 uppercase tracking-wider">Son Bakım</th>
                <th className="px-6 py-4 text-left text-xs font-semibold text-gray-700 uppercase tracking-wider">İşlemler</th>
              </tr>
            </thead>
            <tbody className="divide-y divide-gray-200">
              {filteredDevices.map((device) => (
                <tr key={device.id} className="hover:bg-gray-50 transition-colors">
                  <td className="px-6 py-4">
                    <div>
                      <p className="font-semibold text-gray-900">{device.name}</p>
                      <p className="text-sm text-gray-600">{device.model}</p>
                    </div>
                  </td>
                  <td className="px-6 py-4">
                    <div className="flex items-center space-x-2">
                      <QrCode className="h-4 w-4 text-gray-400" />
                      <span className="font-mono text-sm">{device.serialNumber}</span>
                    </div>
                  </td>
                  <td className="px-6 py-4">
                    <span className="badge badge-gray">{device.category}</span>
                  </td>
                  <td className="px-6 py-4">
                    <div className="flex items-center space-x-1 text-sm text-gray-700">
                      <MapPin className="h-4 w-4 text-gray-400" />
                      <span>{device.location}</span>
                    </div>
                  </td>
                  <td className="px-6 py-4">
                    <DeviceStatusBadge status={device.status} />
                  </td>
                  <td className="px-6 py-4">
                    <div className="flex items-center space-x-1 text-sm text-gray-700">
                      <Calendar className="h-4 w-4 text-gray-400" />
                      <span>{device.lastMaintenance}</span>
                    </div>
                  </td>
                  <td className="px-6 py-4">
                    <a
                      href={`/dashboard/devices/${device.id}`}
                      className="text-blue-600 hover:text-blue-700 font-medium text-sm"
                    >
                      Detaylar →
                    </a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        {/* Pagination */}
        <div className="bg-gray-50 px-6 py-4 flex items-center justify-between border-t border-gray-200">
          <p className="text-sm text-gray-700">
            Toplam <span className="font-semibold">{filteredDevices.length}</span> cihaz gösteriliyor
          </p>
          <div className="flex space-x-2">
            <button className="px-3 py-1 border border-gray-300 rounded text-sm hover:bg-white">Önceki</button>
            <button className="px-3 py-1 bg-blue-600 text-white rounded text-sm">1</button>
            <button className="px-3 py-1 border border-gray-300 rounded text-sm hover:bg-white">2</button>
            <button className="px-3 py-1 border border-gray-300 rounded text-sm hover:bg-white">Sonraki</button>
          </div>
        </div>
      </div>

      {/* Barcode Reader Modal */}
      {showBarcodeReader && (
        <BarcodeReader
          onScan={handleBarcodeScann}
          onClose={() => setShowBarcodeReader(false)}
        />
      )}
    </div>
  )
}

function QuickStat({ label, value, icon, color }: { label: string; value: number; icon: React.ReactNode; color: string }) {
  const colorClasses = {
    blue: 'from-blue-500 to-blue-600',
    green: 'from-green-500 to-green-600',
    orange: 'from-orange-500 to-orange-600',
    purple: 'from-purple-500 to-purple-600',
  }

  return (
    <div className="bg-white rounded-lg shadow p-4 flex items-center justify-between">
      <div>
        <p className="text-gray-600 text-sm">{label}</p>
        <p className="text-2xl font-bold text-gray-900">{value}</p>
      </div>
      <div className={`bg-gradient-to-br ${colorClasses[color as keyof typeof colorClasses]} w-10 h-10 rounded-lg flex items-center justify-center text-white`}>
        {icon}
      </div>
    </div>
  )
}

function DeviceStatusBadge({ status }: { status: string }) {
  const statusConfig: Record<string, { label: string; className: string }> = {
    ACTIVE: { label: 'Aktif', className: 'badge-success' },
    INACTIVE: { label: 'Pasif', className: 'badge-gray' },
    MAINTENANCE: { label: 'Bakımda', className: 'badge-warning' },
    CALIBRATION: { label: 'Kalibrasyonda', className: 'badge-info' },
    REPAIR: { label: 'Onarımda', className: 'badge-danger' },
  }

  const config = statusConfig[status] || { label: status, className: 'badge-gray' }
  return <span className={`badge ${config.className}`}>{config.label}</span>
}
